<?xml version="1.0" encoding="utf-8"?>
<!-- QuickBill keeps business data on the phone only (see the privacy
     policy). Nothing is copied to Google's cloud backup or to another
     device; users move data with the in-app backup file. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
